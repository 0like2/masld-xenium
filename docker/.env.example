# ============================================================
# MASLD Xenium Pipeline - Environment Variables
# ============================================================
# Copy this file to docker/.env and fill in your values.
# Usage: cp docker/.env.example docker/.env

# Path to Xenium output directory on the host machine
# (mounted read-only into the container at /data/input)
HOST_DATA_DIR=/path/to/xenium_outs

# Path to write pipeline results on the host machine
# (mounted read-write into the container at /data/output)
HOST_OUTPUT_DIR=/path/to/output

# Sample identifier (used for file naming and output directories)
SAMPLE_TAG=human_alzheimers

# Run mode: "run" (pipeline), "test" (import check), "shell" (debugging)
RUN_MODE=run
